# http://jeroenjanssens.com/2013/08/16/quickly-navigate-your-filesystem-from-the-command-line.html
# https://github.com/ohmyzsh/ohmyzsh/blob/master/plugins/jump/jump.plugin.zsh
export MARKPATH=/home/mimosinnet/.config/marks

function j { 
	builtin cd -P "$MARKPATH/$1" 2>/dev/null || {echo "No such mark: $1"; return 1}
}

function mark { 
	command mkdir -p "$MARKPATH"; command ln -fns "$(pwd)" "$MARKPATH/$1"
}

function unmark { 
	command rm -i "$MARKPATH/$1"
}

function marks {
	local link max=0
	for link in $MARKPATH/{,.}*(@N); do
		if [[ ${#link:t} -gt $max ]]; then
			max=${#link:t}
		fi
	done
	local printf_markname_template="$(printf -- "%%%us " "$max")"
	for link in $MARKPATH/{,.}*(@N); do
		local markname="$fg[cyan]${link:t}$reset_color"
		local markpath="$fg[blue]$(readlink $link)$reset_color"
		printf -- "$printf_markname_template" "$markname"
		printf -- "-> %s\n" "$markpath"
	done
}

function _completemarks {
  reply=("${MARKPATH}"/{,.}*(@N:t))
}

compctl -K _completemarks j
compctl -K _completemarks unmark

