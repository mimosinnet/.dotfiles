# Funció que ens defineix el prompt en funció de si vim està en modus insertar / cmd
function zle-keymap-select {

    # Quin vim estem fent servir
    # KEYMAP: variable interna de zle-keymap
    # ${variable/si coincideix contingut/substitueix per}
    VIM="${${KEYMAP/vicmd/-cmd-}/(main|viins)/}"

    # Tenir en compte que el prompt ha de ser igual al que definim posteriorment
    RPROMPT=' $PR_GREEN$VIM $PR_BLACK%D{%H:%M} $PR_BLACK%h$LR$PR_CYAN$PR_NO_COLOUR'

    zle reset-prompt
}

zle -N zle-keymap-select

