# http://aperiodic.net/phil/prompt/

# Funció que s'executa abans de cada prompt
function precmd {

    local TERMWIDTH
    # Agafem la variable COLUMNS
    (( TERMWIDTH = ${COLUMNS} - 1 ))


    ###
    # Truncate the path if it's too long.
    
    PR_FILLBAR=""
    PR_PWDLEN=""
   
    # promptsize = longitud del prompt
    # pwdsize = longitud del pwd
    # ${[varname]:-[string]} : Valor de variable o string si variable no existeix
    # ${([flags])[varname]} : fa servir "flags" per alterar valor variable
    # ${(%)[varname]} : El flag fa expansió de prompt en la variable
    # ${#[varname]} : longitud de la varible

    local promptsize=${#${(%):-(%n@%m:%l)-()}}
    local pwdsize=${#${(%):-%~}}
    
    if [[ "$promptsize + $pwdsize" -gt $TERMWIDTH ]]; then
	    ((PR_PWDLEN=$TERMWIDTH - $promptsize))
    else
	    PR_FILLBAR="\${(l.(($TERMWIDTH - ($promptsize + $pwdsize)))..${PR_HBAR}.)}"
    fi
}
