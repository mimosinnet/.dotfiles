#---------------------------------------------------------------------------------------
setprompt () {
    ###
    # Need this so the prompt will work.
    # Definim aquesta opció a .zshrc per tenir les opcions totes juntes
    # setopt prompt_subst

    ###
    # Mirem si podem fer servir colors

    autoload colors zsh/terminfo
    if [[ "$terminfo[colors]" -ge 8 ]]; then
	    colors
    fi

    for color in RED GREEN YELLOW BLUE MAGENTA CYAN WHITE BLACK; do
	    eval PR_$color='%{$terminfo[bold]$fg[${(L)color}]%}'
	    eval PR_LIGHT_$color='%{$fg[${(L)color}]%}'
    done
    PR_NO_COLOUR="%{$terminfo[sgr0]%}"


    ###
    # See if we can use extended characters to look nicer.
    
    # Defineixo una matriu associativa (key,value,key,value,...)
    typeset -A altchar
    # Assigna valors a la matriu 
    set -A altchar ${(s..)terminfo[acsc]}
    PR_SET_CHARSET="%{$terminfo[enacs]%}"
    PR_SHIFT_IN="%{$terminfo[smacs]%}"
    PR_SHIFT_OUT="%{$terminfo[rmacs]%}"
    PR_HBAR=${altchar[q]:--}
    # UpperLeft LowLeft LowRight UpperRight
    PR_ULCORNER=${altchar[l]:--}
    PR_LLCORNER=${altchar[m]:--}
    PR_LRCORNER=${altchar[j]:--}
    PR_URCORNER=${altchar[k]:--}

    UL=$PR_BLACK$PR_SHIFT_IN$PR_ULCORNER$PR_SHIFT_OUT
    LL=$PR_BLACK$PR_SHIFT_IN$PR_LLCORNER$PR_SHIFT_OUT
    LR=$PR_SHIFT_IN$PR_BLACK$PR_LRCORNER$PR_SHIFT_OUT
    UR=$PR_SHIFT_IN$PR_BLACK$PR_URCORNER$PR_SHIFT_OUT


    ###
    # Finally, the prompt.

    # La línea en blanc crea la segona línia en el prompt

    PROMPT='$PR_SET_CHARSET\
$UL\
$PR_WHITE%(!.$PR_RED%SROOT%s.%n)@$PR_YELLOW%m $PR_BLACK%l\
$PR_SHIFT_IN$PR_BLACK$PR_HBAR${(e)PR_FILLBAR}$PR_SHIFT_OUT \
$PR_YELLOW%$PR_PWDLEN<...<%~%<<\
 $UR\

$LL%(?..$PR_LIGHT_RED%?$PR_BLUE:)\
$PR_LIGHT_BLUE%(!.$PR_RED.$PR_WHITE)%#$PR_CYAN$PR_NO_COLOUR '

    # Final de segona línia, que ha de ser igual a la funció anterior
    RPROMPT=' $PR_WHITE%D{%H:%M} $PR_BLACK%h$LR$PR_CYAN$PR_NO_COLOUR'

#     PS2='$PR_CYAN$PR_SHIFT_IN$PR_HBAR$PR_SHIFT_OUT\
# $PR_BLUE$PR_SHIFT_IN$PR_HBAR$PR_SHIFT_OUT(\
# $PR_LIGHT_GREEN%_$PR_BLUE)$PR_SHIFT_IN$PR_HBAR$PR_SHIFT_OUT\
# $PR_CYAN$PR_SHIFT_IN$PR_HBAR$PR_SHIFT_OUT$PR_NO_COLOUR '

}

setprompt

