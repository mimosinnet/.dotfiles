# mode resize (resize containers) {{{2
# resize window (you can also use the mouse for that)
mode "resize" {

	bindsym a exec Gxmessage.zsh ~/.config/sway/help_files/x_help_Resize.txt

    # These bindings trigger as soon as you enter the resize mode

    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym j resize shrink width 10px
    bindsym k resize grow height 10px
    bindsym l resize shrink height 10px
    bindsym ntilde resize grow width 10px

    # same bindings, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # same bindings, but less movement 
    bindsym Shift+Left  resize shrink width  1 px or 1 ppt
    bindsym Shift+Down  resize grow   height 1 px or 1 ppt
    bindsym Shift+Up    resize shrink height 1 px or 1 ppt
    bindsym Shift+Right resize grow   width  1 px or 1 ppt

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

